Options -MultiViews -Indexes +FollowSymLinks
DirectoryIndex index.html

RewriteEngine On
RewriteBase /

# Начальный HTML с названием и обложкой отдаёт API; браузер откроет плеер.
# Без PHP и mod_proxy на статическом хостинге. Query-параметры не передаём.
RewriteRule ^s/([A-Za-z0-9_-]{22}|[A-Za-z0-9_-]{43}|[a-f0-9]{64})/([a-f0-9]{16})/?$ https://api.gpt-chat.by/api/music/shared/$1/preview/$2 [R=302,L,NE,QSD]
RewriteRule ^s/([A-Za-z0-9_-]{22}|[A-Za-z0-9_-]{43}|[a-f0-9]{64})/?$ https://api.gpt-chat.by/api/music/shared/$1/preview [R=302,L,NE,QSD]

# Прежний адрес тоже отдаёт персональное превью. Плеер живёт на /listen/,
# поэтому обратного перенаправления на /p/ нет.
RewriteCond %{QUERY_STRING} (^|&)t=([A-Za-z0-9_-]{22}|[A-Za-z0-9_-]{43}|[a-f0-9]{64})(&|$)
RewriteRule ^p/?$ https://api.gpt-chat.by/api/music/shared/%2/preview [R=302,L,NE,QSD]

RewriteRule ^_nuxt/ - [L]
RewriteRule ^404\.html$ - [L]

RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteRule ^ - [R=404,L]

RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

# MP3 отдаём с правильным типом: плеер и примеры играют без скачивания целиком.
AddType audio/mpeg .mp3

ErrorDocument 404 /404.html
